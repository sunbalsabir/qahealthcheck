# ---------------------------------------------------------------------------
# Qualovix QA Auditor — environment configuration
# Copy to .env and fill in. NEVER commit .env or hardcode secrets in source.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:5000

# --- Persistence ------------------------------------------------------------
# "prisma" = PostgreSQL via Prisma (production / full local stack)
# "memory" = in-process store, no database required (quick start & demos)
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgresql://qualovix:qualovix@localhost:5432/qualovix_auditor?schema=public

# --- Job queue --------------------------------------------------------------
# "bullmq" = Redis-backed queue processed by the worker app (production)
# "inline" = run the audit in-process (no Redis required)
QUEUE_DRIVER=inline
REDIS_URL=redis://localhost:6379

# --- Admin authentication ---------------------------------------------------
# Generate a strong secret:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Bootstrap admin account, created by `npm run db:seed` (Prisma) or on first
# boot (memory driver). Change the password before any real deployment.
ADMIN_EMAIL=qa@qualovix.com
ADMIN_PASSWORD=qualovix-admin
SESSION_TTL_HOURS=12

# --- AI analysis layer (optional) -------------------------------------------
# If unset or unreachable, the system still produces a full deterministic
# report. The AI layer never invents findings and never changes severity.
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=60000

# --- Audit engine limits ----------------------------------------------------
AUDIT_MOCK_MODE=false
MAX_PAGES=10
MAX_DEPTH=2
PAGE_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=15000
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=10485760
AUDIT_JOB_TIMEOUT_MS=600000
MAX_LINK_CHECKS=150
SCREENSHOTS_ENABLED=true
SCREENSHOT_DIR=.data/screenshots

# --- Abuse prevention -------------------------------------------------------
RATE_LIMIT_PER_IP_PER_DAY=3
RATE_LIMIT_PER_DOMAIN_PER_DAY=2
RATE_LIMIT_PER_EMAIL_PER_DAY=3
RATE_LIMIT_GLOBAL_PER_HOUR=60

# --- SSRF policy ------------------------------------------------------------
# Comma-separated hostnames permitted despite failing the public-IP check.
# Intended for local testing only. Leave empty in production.
SSRF_ALLOWLIST=
