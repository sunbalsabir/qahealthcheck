{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@qualovix/shared": ["../../packages/shared/src/index.ts"],
      "@qualovix/shared/*": ["../../packages/shared/src/*"],
      "@qualovix/audit-engine": ["../../packages/audit-engine/src/index.ts"],
      "@qualovix/scanners": ["../../packages/scanners/src/index.ts"],
      "@qualovix/reporting": ["../../packages/reporting/src/index.ts"],
      "@qualovix/data": ["../../packages/data/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
