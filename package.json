{
  "name": "qualovix-qa-auditor",
  "version": "1.0.0",
  "private": true,
  "description": "Qualovix QA Auditor — automated QA health check, reviewed by Qualovix QA engineers.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@qualovix/web",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm:dev\" \"npm:worker\"",
    "worker": "npm run dev --workspace=@qualovix/worker",
    "build": "npm run build --workspace=@qualovix/web",
    "start": "npm run start --workspace=@qualovix/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "playwright:install": "playwright install chromium --with-deps",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
